# ===== 必填 =====

# 对外访问的 https 地址，结尾不带斜杠。
# Telegram Webhook、发给 Crisp 的图片地址都用它拼，必须是公网能访问到的
PUBLIC_URL=https://crispai.example.com

# 管理后台的登录账号密码（浏览器 Basic 认证）。务必只通过 https 访问
ADMIN_USER=admin
ADMIN_PASSWORD=

# Crisp 插件（https://marketplace.crisp.chat 里创建一个私有插件）
# CRISP_ID / CRISP_KEY：插件的 Token Identifier / Key（用 Production token）
# CRISP_SECRET：插件 Web Hooks 的签名密钥
# CRISP_URN：插件的 URN，形如 urn:your.name:pluginname:0
CRISP_ID=
CRISP_KEY=
CRISP_SECRET=
CRISP_URN=

# Telegram 机器人 token（@BotFather 创建）
TELEGRAM_TOKEN=

# OpenAI 或任何兼容接口
OPENAI_URL=https://api.openai.com/v1
OPENAI_KEY=

# ===== 选填 =====

# 对话模型
# OPENAI_MODEL=gpt-4.1-nano
# 向量模型，输出必须是 1536 维
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 宿主机端口
# PORT=3000
# 数据库密码（只在 compose 内部网络可见）。首次启动后再改不会生效
# POSTGRES_PASSWORD=crispai
# LOG_LEVEL=info
